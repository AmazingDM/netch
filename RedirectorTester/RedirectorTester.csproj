<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>App.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <RedirectorBinDir Condition="'$(SolutionDir)' != ''">$(SolutionDir)Redirector\bin\$(Configuration)\</RedirectorBinDir>
    <RedirectorBinDir Condition="'$(SolutionDir)' == ''">$(MSBuildProjectDirectory)\..\Redirector\bin\$(Configuration)\</RedirectorBinDir>
  </PropertyGroup>

  <Target Name="CopyRedirectorArtifacts" AfterTargets="Build">
    <ItemGroup>
      <RedirectorArtifacts Include="$(RedirectorBinDir)nfapi.dll" Condition="Exists('$(RedirectorBinDir)nfapi.dll')" />
      <RedirectorArtifacts Include="$(RedirectorBinDir)Redirector.bin" Condition="Exists('$(RedirectorBinDir)Redirector.bin')" />
      <RedirectorArtifacts Include="$(RedirectorBinDir)Redirector.pdb" Condition="Exists('$(RedirectorBinDir)Redirector.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(RedirectorArtifacts)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
